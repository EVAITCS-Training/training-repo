<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.evaitcs.corejava</groupId>
  <artifactId>core-java</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>

  <name>Core Java Teaching Repo</name>
  <description>
    The foundations course that comes BEFORE java8-features: how Java runs (JVM/JRE/JDK),
    primitives vs references, Strings and their builders, the OOP pillars, access modifiers,
    interfaces vs abstract classes, the equals/hashCode contract, toString, Comparable vs
    Comparator, and static (class-level) vs instance-level members. Every module compiles
    with --release 8 and deliberately teaches the CLASSIC (pre-lambda) idiom first, with
    pointers forward to ../java8-features.
  </description>

  <modules>
    <module>01-jvm-jre-jdk</module>
    <module>02-primitives-vs-references</module>
    <module>03-strings</module>
    <module>04-stringbuilder-stringbuffer</module>
    <module>05-oop-pillars</module>
    <module>06-access-modifiers</module>
    <module>07-interfaces-vs-abstract-classes</module>
    <module>08-equals-hashcode</module>
    <module>09-tostring</module>
    <module>10-comparable-comparator</module>
    <module>11-static-and-class-vs-instance</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- release=8 keeps the whole course on one stable language level; the CLASSIC idiom
         (anonymous inner classes, no var/records) is taught on purpose — lambdas are the
         payoff waiting in the java8-features course. -->
    <maven.compiler.release>8</maven.compiler.release>
    <junit.version>5.10.2</junit.version>
    <surefire.version>3.2.5</surefire.version>
    <compiler.plugin.version>3.13.0</compiler.plugin.version>
    <exec.plugin.version>3.2.0</exec.plugin.version>
  </properties>

  <dependencies>
    <!-- Tests are part of the teaching material: each one proves a claim made in the
         demos/README and prints its evidence, so `mvnw test` doubles as a live show. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${compiler.plugin.version}</version>
          <configuration>
            <compilerArgs>
              <!-- modern JDKs warn that "source 8 is obsolete"; that warning is noise in class -->
              <arg>-Xlint:-options</arg>
            </compilerArgs>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${surefire.version}</version>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>exec-maven-plugin</artifactId>
          <version>${exec.plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <!-- `mvnw -pl <module> compile exec:java` runs the module's demo launcher -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
