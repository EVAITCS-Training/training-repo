<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.evaitcs.advanced</groupId>
  <artifactId>advanced-java</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>

  <name>Advanced Java Teaching Repo</name>
  <description>
    The course after java8-features and before stage-2-monolith: what happens UNDER the
    language. Generics and erasure; reflection; annotations and how frameworks read them;
    threads and the Java Memory Model; locks, conditions and atomics; executors,
    CompletableFuture and virtual threads; JVM memory, GC and leak hunting; IO and NIO;
    the GoF patterns as they appear in the JDK and in banking code; and patterns BEYOND
    the GoF — architectural, concurrency, API idioms and anti-patterns. Unlike the three
    foundational courses, this one runs on Java 21 and uses modern idiom freely (records,
    sealed types, pattern matching, virtual threads). Explanations follow
    ../docs/refs/TEACHING_STYLE.md: plain sentence first, numbered mechanism walkthroughs,
    "Read the diagram" bullets, "In one sentence" takeaways.
  </description>

  <modules>
    <module>01-generics-deep-dive</module>
    <module>02-reflection</module>
    <module>03-annotations</module>
    <module>04-threads-and-jmm</module>
    <module>05-locks-and-atomics</module>
    <module>06-executors-and-async</module>
    <module>07-jvm-memory-and-gc</module>
    <module>08-io-and-nio</module>
    <module>09-design-patterns-gof</module>
    <module>10-patterns-beyond-gof</module>
    <module>11-exceptions</module>
    <module>12-jdbc</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Java 21: the level stage-2-monolith actually runs on. Virtual threads, records,
         sealed types and pattern matching are teaching material here, not contraband. -->
    <maven.compiler.release>21</maven.compiler.release>
    <junit.version>5.10.2</junit.version>
    <surefire.version>3.2.5</surefire.version>
    <compiler.plugin.version>3.13.0</compiler.plugin.version>
    <exec.plugin.version>3.2.0</exec.plugin.version>
  </properties>

  <dependencies>
    <!-- Tests are part of the teaching material: each one proves a claim made in the
         demos/README and prints its evidence, so `mvnw test` doubles as a live show. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${compiler.plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${surefire.version}</version>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>exec-maven-plugin</artifactId>
          <version>${exec.plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <!-- `mvnw -pl <module> compile exec:java` runs the module's demo launcher -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
